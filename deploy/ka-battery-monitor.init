#!/bin/sh /etc/rc.common
# KickAss Battery Monitor dashboard - OpenWrt procd service.
# Runs run_server_ingest.py (server.py + ingest_poller.py as the BLE
# backend, fed by the ESP32 bridge - see ../esp32_firmware/README.md)
# on port 5000.
#
# Install: copy to /etc/init.d/ka-battery-monitor on the router, then:
#   chmod +x /etc/init.d/ka-battery-monitor
#   /etc/init.d/ka-battery-monitor enable   # start on boot
#   /etc/init.d/ka-battery-monitor start
# Logs go to the system log - view with `logread` or `logread -f`.

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 /root/ka_battery_monitor/run_server_ingest.py --host 0.0.0.0 --port 5000
	# server.py resolves "static" relative to the process's cwd, not the
	# script's own location - procd doesn't default to either, so this is
	# required, not just tidiness. Confirmed the hard way (RuntimeError:
	# Directory 'static' does not exist).
	procd_set_param cwd /root/ka_battery_monitor
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
